#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/TULPAR.proto"

WorldInfo { title "TULPAR controlled university demonstration" basicTimeStep 32 }
Viewpoint { orientation -0.465 0.218 0.858 1.18 position 3.9 -5.2 3.55 }
Background { skyColor [ 0.035 0.07 0.11 ] }
TexturedBackground { }
TexturedBackgroundLight { }

DirectionalLight { direction -0.2 -0.35 -1 intensity 2.2 castShadows TRUE }
PointLight { location 0 0 3 color 0.83 0.91 1 intensity 1.3 radius 7 castShadows TRUE }
PointLight { location -2 1.4 2.3 color 1 0.82 0.58 intensity 0.7 radius 4 }

Solid {
  translation 0 0 -0.06
  name "room floor"
  children [ Shape { appearance PBRAppearance { baseColor 0.42 0.46 0.49 roughness 0.86 } geometry Box { size 7 6 0.12 } } ]
  boundingObject Box { size 7 6 0.12 }
}
Solid {
  translation 0 2.95 1.45
  children [ Shape { appearance PBRAppearance { baseColor 0.16 0.20 0.25 roughness 0.8 } geometry Box { size 7 0.1 3 } } ]
  boundingObject Box { size 7 0.1 3 }
}
Solid {
  translation 3.45 0 1.45
  children [ Shape { appearance PBRAppearance { baseColor 0.12 0.16 0.2 roughness 0.8 } geometry Box { size 0.1 6 3 } } ]
  boundingObject Box { size 0.1 6 3 }
}

# Carpet area for the later friction comparison.
Solid {
  translation -1.2 1.35 0.012
  name "carpet test patch"
  children [ Shape { appearance PBRAppearance { baseColor 0.17 0.31 0.38 roughness 1 } geometry Box { size 2.4 1.55 0.024 } } ]
  boundingObject Box { size 2.4 1.55 0.024 }
}

# Tabletop support; the robot is moved here only between trials.
Solid {
  translation -2.45 -1.65 0.47
  name "tabletop support"
  children [
    Shape { appearance PBRAppearance { baseColor 0.60 0.39 0.22 roughness 0.68 } geometry Box { size 1.35 0.85 0.07 } }
    Pose { translation 0.52 0.3 -0.47 children [ Shape { appearance PBRAppearance { baseColor 0.20 0.23 0.25 roughness 0.75 } geometry Box { size 0.06 0.06 0.92 } } ] }
    Pose { translation -0.52 0.3 -0.47 children [ Shape { appearance PBRAppearance { baseColor 0.20 0.23 0.25 roughness 0.75 } geometry Box { size 0.06 0.06 0.92 } } ] }
    Pose { translation 0.52 -0.3 -0.47 children [ Shape { appearance PBRAppearance { baseColor 0.20 0.23 0.25 roughness 0.75 } geometry Box { size 0.06 0.06 0.92 } } ] }
    Pose { translation -0.52 -0.3 -0.47 children [ Shape { appearance PBRAppearance { baseColor 0.20 0.23 0.25 roughness 0.75 } geometry Box { size 0.06 0.06 0.92 } } ] }
  ]
  boundingObject Box { size 1.35 0.85 0.07 }
}

# Demonstration-zone boundary markers.
DEF START_MARKER Solid {
  translation -1.7 -1.1 0.015
  children [ Shape { appearance PBRAppearance { baseColor 0.10 0.65 0.74 emissiveColor 0.02 0.12 0.15 } geometry Cylinder { radius 0.13 height 0.03 } } ]
}
DEF MARKER_A Solid {
  translation 1.35 1.15 0.16
  name "marked target A"
  children [
    Shape { appearance PBRAppearance { baseColor 0.95 0.62 0.15 emissiveColor 0.22 0.09 0.01 } geometry Cylinder { radius 0.14 height 0.03 } }
    Pose { translation 0 0 0.28 children [ Shape { appearance PBRAppearance { baseColor 1 0.72 0.22 emissiveColor 0.32 0.12 0.01 } geometry Box { size 0.10 0.05 0.50 } } ] }
  ]
  boundingObject Cylinder { radius 0.14 height 0.03 }
}
DEF MARKER_B Solid {
  translation 0.85 1.95 0.16
  name "marked target B"
  children [
    Shape { appearance PBRAppearance { baseColor 0.58 0.20 0.88 emissiveColor 0.12 0.02 0.22 } geometry Cylinder { radius 0.14 height 0.03 } }
    Pose { translation 0 0 0.28 children [ Shape { appearance PBRAppearance { baseColor 0.70 0.38 1 emissiveColor 0.16 0.04 0.30 } geometry Box { size 0.10 0.05 0.50 } } ] }
  ]
  boundingObject Cylinder { radius 0.14 height 0.03 }
}

# Operator figure. The pose is deliberately simple and visible from the robot camera.
DEF OPERATOR Solid {
  translation 1.45 -1.1 0
  name "operator"
  children [
    Pose { translation 0 0 0.88 children [ Shape { appearance PBRAppearance { baseColor 0.14 0.34 0.56 roughness 0.65 } geometry Capsule { radius 0.18 height 0.72 } } ] }
    Pose { translation 0 0 1.42 children [ Shape { appearance PBRAppearance { baseColor 0.78 0.54 0.36 roughness 0.7 } geometry Sphere { radius 0.15 } } ] }
    Pose { translation -0.10 -0.28 1.05 rotation 1 0 0 0.65 children [ Shape { appearance PBRAppearance { baseColor 0.14 0.34 0.56 roughness 0.65 } geometry Cylinder { radius 0.055 height 0.52 } } ] }
    Pose { translation -0.10 -0.49 1.28 children [ Shape { appearance PBRAppearance { baseColor 0.78 0.54 0.36 roughness 0.7 } geometry Sphere { radius 0.07 } } ] }
  ]
  boundingObject Capsule { radius 0.20 height 1.5 }
}

# Benches and a plant are kept outside the tested routes.
Solid {
  translation -2.5 1.75 0.34
  children [ Shape { appearance PBRAppearance { baseColor 0.32 0.42 0.47 roughness 0.72 } geometry Box { size 1.25 0.45 0.45 } } ]
  boundingObject Box { size 1.25 0.45 0.45 }
}
Solid {
  translation 2.55 1.85 0.36
  children [
    Shape { appearance PBRAppearance { baseColor 0.35 0.23 0.14 roughness 0.85 } geometry Cylinder { radius 0.23 height 0.42 } }
    Pose { translation 0 0 0.48 children [ Shape { appearance PBRAppearance { baseColor 0.16 0.52 0.28 roughness 0.66 } geometry Sphere { radius 0.40 } } ] }
  ]
  boundingObject Cylinder { radius 0.23 height 0.42 }
}

TULPAR {
  translation -1.7 -1.1 0.06
  rotation 0 0 1 0
  name "TULPAR"
  controller "tulpar_controller"
}
